{
  "name": "femods_api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "CC-BY-NC-ND-4.0",
  "homepage": "https://github.com/fegorka/femods_api#readme",
  "author": {
    "name": "Egor Fokin",
    "email": "dm@fegorka.com",
    "url": "https://fegorka.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fegorka/femods_api.git"
  },
  "bugs": {
    "url": "https://github.com/fegorka/femods_api/issues"
  },
  "scripts": {
    "bump": "standard-version --skip.tag",
    "release": "npm run build && git flow release start `node bin/nextVersion.js`",
    "finish": "git flow release finish `node bin/currentVersion.js`",
    "start": "node bin/server.js",
    "build": "node ace build",
    "serve": "tsc && node ace serve --watch",
    "serve-no-typecheck": "node ace serve --watch",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#start/*": "./start/*.js",
    "#tests/*": "./tests/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.4.0",
    "@adonisjs/eslint-config": "^1.3.0",
    "@adonisjs/prettier-config": "^1.3.0",
    "@adonisjs/tsconfig": "^1.3.0",
    "@japa/api-client": "^3.1.0",
    "@japa/assert": "^4.0.1",
    "@japa/plugin-adonisjs": "^3.0.1",
    "@japa/runner": "^3.1.2",
    "@swc/core": "^1.4.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.12.7",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.2.5",
    "standard-version": "^9.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@adonisjs/ally": "^5.0.2",
    "@adonisjs/auth": "^9.2.0",
    "@adonisjs/bouncer": "^3.1.2",
    "@adonisjs/core": "^6.6.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^20.5.1",
    "@adonisjs/redis": "^9.2.0",
    "@vinejs/vine": "^2.0.0",
    "luxon": "^3.4.4",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2"
  },
  "eslintConfig": {
    "extends": "@adonisjs/eslint-config/app"
  },
  "prettier": "@adonisjs/prettier-config"
}
